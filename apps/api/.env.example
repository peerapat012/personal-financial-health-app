APP_ENV=development
DATABASE_URL=postgresql+psycopg://app_user:replace-me@replace-me-pooler.neon.tech/personal_app?sslmode=require
DATABASE_DIRECT_URL=postgresql+psycopg://migration_user:replace-me@replace-me.neon.tech/personal_app?sslmode=require
PERSONAL_API_TOKEN_SHA256=replace-with-a-64-character-lowercase-sha256-digest
# Enable after deploying apps/auth and provisioning its owner. No token fallback in better_auth mode.
AUTH_MODE=personal_token
# BETTER_AUTH_URL=https://your-auth-service.example.com
# OWNER_USER_ID=the-provisioned-better-auth-user-id
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
LOG_LEVEL=INFO
PORT=8000
